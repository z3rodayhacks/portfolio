---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../../lib/utils';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<section class="py-20 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-end justify-between mb-12">
      <div>
        <p class="section-label mb-2">Selected work</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-100">Featured Projects</h2>
      </div>
      <a href="/projects" class="hidden sm:flex items-center gap-1.5 text-sm text-zinc-500 hover:text-cyan-400 transition-colors font-mono">
        all projects →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {projects.map((project) => (
        <a
          href={`/projects/${project.id}`}
          class="group relative flex flex-col bg-zinc-900/50 border border-zinc-800 rounded-lg overflow-hidden card-hover"
        >
          <!-- Thumbnail -->
          {project.data.thumbnail ? (
            <div class="relative h-44 overflow-hidden bg-zinc-900">
              <img
                src={project.data.thumbnail}
                alt={project.data.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-900 via-transparent to-transparent"></div>
            </div>
          ) : (
            <div class="h-44 bg-zinc-900 flex items-center justify-center">
              <div class="terminal p-4 text-center">
                <p class="font-mono text-xs text-cyan-400">
                  <span class="text-zinc-500">$</span> ./run.sh
                </p>
              </div>
            </div>
          )}

          <!-- Content -->
          <div class="flex-1 flex flex-col p-5">
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="font-semibold text-zinc-100 group-hover:text-cyan-400 transition-colors leading-tight">
                {project.data.title}
              </h3>
              <span class={`shrink-0 px-2 py-0.5 rounded text-xs font-mono font-medium ${
                project.data.status === 'completed'   ? 'bg-cyan-500/10 text-cyan-400' :
                project.data.status === 'in-progress' ? 'bg-yellow-500/10 text-yellow-400' :
                                                         'bg-zinc-700/50 text-zinc-500'
              }`}>
                {project.data.status}
              </span>
            </div>
            <p class="text-sm text-zinc-500 leading-relaxed flex-1 mb-4">
              {project.data.description}
            </p>

            <!-- Tags -->
            {project.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mb-4">
                {project.data.tags.slice(0, 4).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
                {project.data.tags.length > 4 && (
                  <span class="tag">+{project.data.tags.length - 4}</span>
                )}
              </div>
            )}

            <!-- Footer -->
            <div class="flex items-center justify-between pt-3 border-t border-zinc-800 text-xs text-zinc-600 font-mono">
              <span>{formatDate(project.data.date, { year: 'numeric', month: 'short' })}</span>
              <div class="flex items-center gap-3">
                {project.data.github && (
                  <span class="flex items-center gap-1 text-zinc-500 hover:text-cyan-400" onclick="event.preventDefault(); window.open(this.dataset.href, '_blank');" data-href={project.data.github}>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                    GitHub
                  </span>
                )}
                <span class="text-cyan-500 group-hover:translate-x-1 transition-transform inline-block">→</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 sm:hidden text-center">
      <a href="/projects" class="text-sm text-zinc-500 hover:text-cyan-400 transition-colors font-mono">
        view all projects →
      </a>
    </div>
  </div>
</section>
