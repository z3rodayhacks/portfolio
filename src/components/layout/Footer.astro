---
const year = new Date().getFullYear();

const links = [
  { href: '/projects',     label: 'Projects' },
  { href: '/blog',         label: 'Blog' },
  { href: '/talks',        label: 'Talks' },
  { href: '/certificates',  label: 'Certs' },
  { href: '/competitions',  label: 'Competitions' },
  { href: '/timeline',      label: 'Timeline' },
  { href: '/contact',      label: 'Contact' },
];

const social = [
  { href: 'https://github.com/z3rodayhacks',                           label: 'GitHub', icon: 'github' },
  { href: 'https://linkedin.com/in/jashwanth-raghav-5a9111313/',       label: 'LinkedIn', icon: 'linkedin' },
  { href: '/rss.xml',                                                   label: 'RSS Feed', icon: 'rss' },
];
---

<footer class="mt-24 border-t border-zinc-800/40 bg-[#080808]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div>
        <a href="/" class="font-mono font-bold text-lg">
          <span class="text-zinc-500">/</span><span class="text-cyan-400">z3roday</span><span class="text-zinc-500">~</span>
        </a>
        <p class="mt-3 text-sm text-zinc-500 leading-relaxed max-w-xs">
          Cybersecurity professional building secure systems,
          writing about security research, and sharing knowledge with the community.
        </p>
        <div class="mt-4 flex items-center gap-2">
          {social.map(({ href, label, icon }) => (
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="p-2 rounded border border-zinc-800 text-zinc-500 hover:text-cyan-400 hover:border-cyan-500/30 transition-all"
              aria-label={label}
              title={label}
            >
              {icon === 'github' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              )}
              {icon === 'linkedin' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {icon === 'twitter' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              )}
              {icon === 'rss' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="section-label mb-4">Navigation</h3>
        <ul class="space-y-2">
          {links.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-zinc-500 hover:text-cyan-400 transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick info -->
      <div>
        <h3 class="section-label mb-4">Status</h3>
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
            <span class="text-sm text-zinc-400">Available for opportunities</span>
          </div>
          <p class="text-xs text-zinc-600 font-mono">
            Built with Astro · Hosted on Cloudflare
          </p>
          <a href="/rss.xml" class="inline-flex items-center gap-1.5 text-xs text-zinc-600 hover:text-cyan-400 transition-colors font-mono">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"/>
            </svg>
            Subscribe via RSS
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-zinc-800/40 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-zinc-600 font-mono">
      <span>© {year} - All rights reserved</span>
      <div class="flex items-center gap-4">
        <a href="/sitemap-index.xml" class="hover:text-cyan-400 transition-colors">sitemap</a>
        <a href="/rss.xml"           class="hover:text-cyan-400 transition-colors">rss</a>
        <a href="/robots.txt"        class="hover:text-cyan-400 transition-colors">robots.txt</a>
      </div>
    </div>
  </div>
</footer>
