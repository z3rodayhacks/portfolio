---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  class?: string;
}

const {
  title,
  description = 'Jashwanth Raghav - Cybersecurity Researcher, Security Consultant, OWASP SREC Chairman, Malware & Dark Web Researcher based in Coimbatore, India.',
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  class: className = '',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type"        content={type} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="z3roday | Jashwanth Raghav" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" sizes="32x32"        href="/favicon-32.png" />
    <link rel="apple-touch-icon"          href="/apple-touch-icon.png" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    <!-- Inter font (system fallback - no external requests needed for performance) -->
    <!-- To use Google Fonts, add: <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet"> -->

    <meta name="author" content="Jashwanth Raghav R K" />
    <title>{title}</title>

    <!-- Person schema — tells Google these pages belong to Jashwanth Raghav -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jashwanth Raghav R K",
      "alternateName": ["Jashwanth Raghav", "z3rodayhacks"],
      "url": canonicalURL.origin,
      "image": `${canonicalURL.origin}/profile/photo.jpg`,
      "jobTitle": "Cybersecurity Researcher & Security Consultant",
      "description": "Cybersecurity Researcher and Security Consultant, OWASP SREC Chairman, malware analyst, CTF player, and dark web researcher based in Coimbatore, India.",
      "sameAs": [
        "https://www.linkedin.com/in/jashwanth-raghav-5a9111313/",
        "https://github.com/z3rodayhacks",
        "https://medium.com/@rkjashwanthraghav01"
      ],
      "worksFor": { "@type": "Organization", "name": "TechGuard Labs" },
      "knowsAbout": [
        "Cybersecurity", "Penetration Testing", "Malware Analysis",
        "CTF", "Reverse Engineering", "Dark Web Research", "OSINT",
        "Network Security", "Incident Response"
      ]
    })} />
    <!-- Runtime theme override (reads /theme.json written by admin panel) -->
    <script is:inline>
      (function () {
        function applyTheme(t) {
          var root = document.documentElement;
          var body = document.body;
          if (t.bg)      { root.style.setProperty('--color-bg', t.bg);      body.style.backgroundColor = t.bg; }
          if (t.surface) { root.style.setProperty('--color-surface', t.surface); }
          if (t.card)    { root.style.setProperty('--color-card', t.card); }
          if (t.text)    { root.style.setProperty('--color-text', t.text);   body.style.color = t.text; }
          if (t.muted)   { root.style.setProperty('--color-muted', t.muted); }
          if (t.border)  { root.style.setProperty('--color-border', t.border); }
          if (t.wallpaper) {
            body.style.backgroundImage    = 'url(' + t.wallpaper + ')';
            body.style.backgroundSize     = 'cover';
            body.style.backgroundPosition = 'center';
            body.style.backgroundAttachment = 'fixed';
            body.style.backgroundRepeat   = 'no-repeat';
            // overlay so text stays readable
            var ov = document.getElementById('_theme_overlay');
            if (!ov) { ov = document.createElement('div'); ov.id = '_theme_overlay'; document.body.prepend(ov); }
            var opacity = t.wallpaperOverlay !== undefined ? t.wallpaperOverlay : 0.75;
            ov.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,' + opacity + ');z-index:0;pointer-events:none;';
          }
        }
        // apply cached immediately (no flash)
        try { var c = localStorage.getItem('_pt'); if (c) applyTheme(JSON.parse(c)); } catch(e) {}
        // fetch fresh
        fetch('/theme.json').then(function(r){ return r.ok ? r.json() : null; }).then(function(t){
          if (!t) return;
          try { localStorage.setItem('_pt', JSON.stringify(t)); } catch(e) {}
          applyTheme(t);
        }).catch(function(){});
      })();
    </script>
  </head>
  <body class={`min-h-screen flex flex-col bg-[#1a1a1a] text-zinc-100 ${className}`}>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
