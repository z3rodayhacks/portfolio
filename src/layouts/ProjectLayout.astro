---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  date: string;
  tags: string[];
  thumbnail?: string;
  github?: string;
  demo?: string;
  status: string;
  techStack: string[];
}

const { title, description, date, tags, thumbnail, github, demo, status, techStack } = Astro.props;
---

<BaseLayout title={`${title} — Projects`} description={description} image={thumbnail}>
  <article class="py-16 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto">

      <!-- Breadcrumb -->
      <nav class="mb-8 font-mono text-xs text-zinc-600" aria-label="Breadcrumb">
        <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
        <span class="mx-2 text-zinc-700">/</span>
        <a href="/projects" class="hover:text-emerald-400 transition-colors">Projects</a>
        <span class="mx-2 text-zinc-700">/</span>
        <span class="text-zinc-500 truncate max-w-[20ch] inline-block align-bottom">{title}</span>
      </nav>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class={`px-2.5 py-1 rounded text-xs font-mono font-semibold ${
            status === 'completed'   ? 'bg-emerald-500/12 text-emerald-400 border border-emerald-500/25' :
            status === 'in-progress' ? 'bg-yellow-500/12 text-yellow-400 border border-yellow-500/25' :
                                       'bg-zinc-700/30 text-zinc-500 border border-zinc-700'
          }`}>{status}</span>
          <time class="font-mono text-xs text-zinc-600" datetime={date}>{formatDate(date)}</time>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-zinc-100 leading-tight mb-4">{title}</h1>
        <p class="text-base text-zinc-400 leading-relaxed mb-6 max-w-2xl">{description}</p>

        <!-- Action links -->
        <div class="flex flex-wrap gap-3">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 border border-zinc-700 hover:border-zinc-500 text-zinc-200 hover:text-white rounded text-sm font-medium transition-all">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
              GitHub
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded text-sm font-semibold transition-all">
              Live Demo ↗
            </a>
          )}
        </div>
      </header>

      <!-- Thumbnail -->
      {thumbnail && (
        <img src={thumbnail} alt={title} loading="eager" decoding="async"
          class="w-full rounded-lg mb-10 object-cover h-64 sm:h-96 border border-zinc-800" />
      )}

      <!-- Tech stack -->
      {techStack.length > 0 && (
        <div class="mb-10 p-5 bg-zinc-900/50 border border-zinc-800 rounded-lg">
          <p class="section-label mb-3">Tech Stack</p>
          <div class="flex flex-wrap gap-2">
            {techStack.map((tech) => (
              <span class="px-3 py-1 bg-zinc-800/80 border border-zinc-700 rounded text-sm font-mono text-zinc-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mb-10 flex flex-wrap gap-2">
          {tags.map((tag) => <span class="tag green">{tag}</span>)}
        </div>
      )}

      <!-- Project content -->
      <div class="prose prose-invert prose-lg max-w-none">
        <slot />
      </div>

      <!-- Footer -->
      <div class="mt-16 pt-8 border-t border-zinc-800">
        <a href="/projects" class="flex items-center gap-2 text-sm text-zinc-500 hover:text-emerald-400 transition-colors font-mono w-fit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5M12 5l-7 7 7 7"/>
          </svg>
          Back to Projects
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
