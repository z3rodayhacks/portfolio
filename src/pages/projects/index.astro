---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, allTags, formatDate } from '../../lib/utils';

const allProjects = await getCollection('projects');
const sorted      = sortByDate(allProjects);
const tags        = allTags(allProjects);

// URL-based tag filter
const { searchParams } = Astro.url;
const activeTag = searchParams.get('tag') ?? undefined;
const filtered  = activeTag ? sorted.filter((p) => p.data.tags.includes(activeTag)) : sorted;
---

<BaseLayout title="Projects — Cybersecurity Portfolio" description="Security research projects, tools, and explorations in offensive and defensive security.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <div class="mb-12">
        <p class="section-label mb-3">My work</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Projects</h1>
        <p class="text-zinc-400 max-w-2xl">
          Security research, tools, vulnerability disclosures, and experiments. All projects are
          for educational or legitimate security purposes.
        </p>
      </div>

      <!-- Tag filter -->
      {tags.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2 items-center">
          <a href="/projects" class={`tag ${!activeTag ? 'active' : ''}`}>All</a>
          {tags.map((tag) => (
            <a href={`/projects?tag=${encodeURIComponent(tag)}`} class={`tag ${activeTag === tag ? 'active' : ''}`}>
              {tag}
            </a>
          ))}
        </div>
      )}

      <!-- Count -->
      <p class="text-xs text-zinc-600 font-mono mb-6">{filtered.length} project{filtered.length !== 1 ? 's' : ''}</p>

      <!-- Grid -->
      {filtered.length === 0 ? (
        <div class="text-center py-20 text-zinc-600">
          <p class="font-mono">No projects found for tag "{activeTag}"</p>
          <a href="/projects" class="mt-4 inline-block text-emerald-400 hover:underline text-sm">Clear filter</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {filtered.map((project) => (
            <a href={`/projects/${project.id}`}
              class="group flex flex-col bg-zinc-900/50 border border-zinc-800 rounded-lg overflow-hidden card-hover">
              {project.data.thumbnail ? (
                <div class="h-40 overflow-hidden bg-zinc-900">
                  <img src={project.data.thumbnail} alt={project.data.title} loading="lazy" decoding="async"
                    class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" />
                </div>
              ) : (
                <div class="h-40 bg-zinc-900/80 flex items-center justify-center border-b border-zinc-800">
                  <span class="font-mono text-zinc-700 text-sm">{project.data.category ?? 'Security'}</span>
                </div>
              )}
              <div class="flex-1 flex flex-col p-5">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h2 class="font-semibold text-zinc-100 group-hover:text-emerald-400 transition-colors leading-tight">
                    {project.data.title}
                  </h2>
                  <span class={`shrink-0 px-2 py-0.5 text-xs font-mono rounded ${
                    project.data.status === 'completed'   ? 'bg-emerald-500/10 text-emerald-400' :
                    project.data.status === 'in-progress' ? 'bg-yellow-500/10 text-yellow-400' :
                                                             'bg-zinc-700/30 text-zinc-500'
                  }`}>{project.data.status}</span>
                </div>
                <p class="text-sm text-zinc-500 leading-relaxed flex-1 mb-4">{project.data.description}</p>
                {project.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    {project.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                )}
                <div class="flex items-center justify-between pt-3 border-t border-zinc-800 text-xs text-zinc-600 font-mono">
                  <span>{formatDate(project.data.date, { year: 'numeric', month: 'short' })}</span>
                  <span class="text-emerald-500 group-hover:translate-x-1 transition-transform inline-block">→</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
