---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, formatDate } from '../lib/utils';

const allItems = await getCollection('timeline');
const sorted   = sortByDate(allItems);

const typeConfig: Record<string, { color: string; label: string }> = {
  work:        { color: 'text-blue-400 border-blue-400/30 bg-blue-400/5',    label: 'Work' },
  education:   { color: 'text-purple-400 border-purple-400/30 bg-purple-400/5', label: 'Education' },
  achievement: { color: 'text-yellow-400 border-yellow-400/30 bg-yellow-400/5', label: 'Achievement' },
  project:     { color: 'text-purple-400 border-purple-400/30 bg-purple-400/5', label: 'Project' },
  other:       { color: 'text-zinc-400 border-zinc-600 bg-zinc-800/50',        label: 'Other' },
};
---

<BaseLayout title="Timeline - Cybersecurity Portfolio" description="My journey through cybersecurity - career milestones, education, achievements, and projects.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-3xl mx-auto">

      <div class="mb-16">
        <p class="section-label mb-3">Journey</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Timeline</h1>
        <p class="text-zinc-400 max-w-xl">A chronological view of my career, education, and key achievements.</p>
      </div>

      {sorted.length === 0 ? (
        <div class="text-center py-20">
          <p class="font-mono text-zinc-600">No timeline entries yet.</p>
          <p class="text-zinc-700 text-sm mt-2">Add <code class="font-mono text-xs bg-zinc-900 px-1.5 py-0.5 rounded border border-zinc-800">src/content/timeline/*.md</code> files.</p>
        </div>
      ) : (
        <div class="relative">
          <!-- Vertical line -->
          <div class="absolute left-4 top-0 bottom-0 w-px bg-zinc-800" aria-hidden="true"></div>

          <div class="flex flex-col gap-8">
            {sorted.map((item) => {
              const cfg = typeConfig[item.data.type] ?? typeConfig.other;
              return (
                <div class="relative pl-12">
                  <!-- Dot -->
                  <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-zinc-900 border-2 border-zinc-700 flex items-center justify-center" aria-hidden="true">
                    <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
                  </div>

                  <div class="p-5 bg-zinc-900/40 border border-zinc-800 rounded-lg hover:border-zinc-700 transition-colors">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                      <div>
                        <h2 class="font-semibold text-zinc-100">{item.data.title}</h2>
                        {item.data.organization && (
                          <p class="text-sm text-zinc-500 mt-0.5">{item.data.organization}</p>
                        )}
                      </div>
                      <div class="flex items-center gap-2 shrink-0">
                        <span class={`px-2 py-0.5 rounded text-xs font-mono border ${cfg.color}`}>
                          {cfg.label}
                        </span>
                        <time class="text-xs text-zinc-600 font-mono" datetime={item.data.date}>
                          {formatDate(item.data.date, { year: 'numeric', month: 'short' })}
                        </time>
                      </div>
                    </div>
                    <p class="text-sm text-zinc-500 leading-relaxed">{item.data.description}</p>
                    {item.data.location && (
                      <p class="mt-2 text-xs text-zinc-600 font-mono flex items-center gap-1">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {item.data.location}
                      </p>
                    )}
                    {item.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {item.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
