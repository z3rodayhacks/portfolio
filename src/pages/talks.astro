---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, formatDate } from '../lib/utils';

const allTalks = await getCollection('talks');
const sorted   = sortByDate(allTalks);
---

<BaseLayout title="Talks — Cybersecurity Portfolio" description="Conference talks, webinars, and workshop presentations on cybersecurity topics.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">

      <div class="mb-12">
        <p class="section-label mb-3">Speaking</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Talks & Presentations</h1>
        <p class="text-zinc-400 max-w-xl">
          Conference presentations, workshops, and webinars on security research and techniques.
        </p>
      </div>

      {sorted.length === 0 ? (
        <div class="text-center py-20">
          <p class="font-mono text-zinc-600">No talks added yet.</p>
          <p class="text-zinc-700 text-sm mt-2">Add <code class="font-mono text-xs bg-zinc-900 px-1.5 py-0.5 rounded border border-zinc-800">src/content/talks/*.md</code> files to populate this page.</p>
        </div>
      ) : (
        <div class="flex flex-col gap-5">
          {sorted.map((talk) => (
            <article class="p-6 bg-zinc-900/40 border border-zinc-800 rounded-lg hover:border-zinc-700 transition-colors">
              <div class="flex flex-col sm:flex-row gap-5">
                {talk.data.thumbnail && (
                  <div class="sm:w-48 h-32 shrink-0 rounded overflow-hidden bg-zinc-900">
                    <img src={talk.data.thumbnail} alt={talk.data.title} loading="lazy" decoding="async"
                      class="w-full h-full object-cover opacity-80" />
                  </div>
                )}
                <div class="flex-1">
                  <div class="flex items-center gap-2 text-xs text-zinc-600 font-mono mb-2">
                    <time datetime={talk.data.date}>{formatDate(talk.data.date, { year: 'numeric', month: 'short' })}</time>
                    <span class="text-zinc-700">·</span>
                    <span class="text-emerald-400">{talk.data.event}</span>
                    {talk.data.location && <><span class="text-zinc-700">·</span><span>{talk.data.location}</span></>}
                  </div>
                  <h2 class="font-semibold text-zinc-100 text-lg leading-snug mb-2">{talk.data.title}</h2>
                  <p class="text-sm text-zinc-500 leading-relaxed mb-4">{talk.data.description}</p>
                  {talk.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-4">
                      {talk.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
                  )}
                  <div class="flex gap-3">
                    {talk.data.slides && (
                      <a href={talk.data.slides} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded text-sm transition-all">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        Slides
                      </a>
                    )}
                    {talk.data.video && (
                      <a href={talk.data.video} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/15 border border-emerald-500/25 text-emerald-400 rounded text-sm transition-all">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        Watch
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
