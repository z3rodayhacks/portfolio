---
import BaseLayout from '../layouts/BaseLayout.astro';

// Gallery reads images directly from the public/images/ folder.
// Add images to public/images/gallery/ and they'll appear here automatically
// when you list them in this frontmatter or a JSON/markdown config file.
//
// For a fully automatic approach, populate gallery-index.json:
// public/gallery-index.json → [{ "src": "/images/gallery/photo.jpg", "alt": "...", "caption": "..." }]
// Then fetch it here.

// Default: import from a JSON config file in public/
let images: Array<{ src: string; alt: string; caption?: string }> = [];
try {
  // During build, attempt to load gallery index.
  // To add images: edit public/gallery-index.json
  const response = await fetch(new URL('/gallery-index.json', Astro.site ?? 'http://localhost:4321').toString()).catch(() => null);
  if (response?.ok) {
    images = await response.json();
  }
} catch { /* no gallery index yet */ }
---

<BaseLayout title="Gallery — Cybersecurity Portfolio" description="Photos from conferences, talks, hackathons, and security events.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">

      <div class="mb-12">
        <p class="section-label mb-3">Visual</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Gallery</h1>
        <p class="text-zinc-400 max-w-xl">
          Snapshots from conferences, hackathons, community events, and workshops.
        </p>
        <p class="mt-3 text-xs font-mono text-zinc-700">
          Add images to <code class="bg-zinc-900 px-1.5 py-0.5 rounded border border-zinc-800">public/images/gallery/</code>
          and list them in <code class="bg-zinc-900 px-1.5 py-0.5 rounded border border-zinc-800">public/gallery-index.json</code>
        </p>
      </div>

      {images.length === 0 ? (
        <div class="text-center py-20 border border-dashed border-zinc-800 rounded-lg">
          <svg class="w-12 h-12 mx-auto mb-4 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          <p class="font-mono text-zinc-600 text-sm">No images yet</p>
          <p class="text-zinc-700 text-xs mt-2">
            Create <code class="font-mono">public/gallery-index.json</code> with an array of image objects
          </p>
          <div class="mt-6 max-w-md mx-auto text-left">
            <pre class="terminal p-4 text-xs text-zinc-400 overflow-x-auto"><code>{`// public/gallery-index.json
[
  {
    "src": "/images/gallery/defcon-2024.jpg",
    "alt": "DEF CON 2024",
    "caption": "Speaking at DEF CON 32"
  }
]`}</code></pre>
          </div>
        </div>
      ) : (
        <>
          <!-- Masonry grid via CSS columns -->
          <div class="columns-2 sm:columns-3 lg:columns-4 gap-3 space-y-3" id="gallery-grid">
            {images.map((img, i) => (
              <div
                class="break-inside-avoid overflow-hidden rounded-lg border border-zinc-800 cursor-zoom-in group"
                data-lightbox={img.src}
                data-caption={img.caption ?? img.alt}
                tabindex="0"
                role="button"
                aria-label={`View full size: ${img.alt}`}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  loading={i < 6 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="w-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
                />
                {img.caption && (
                  <p class="px-3 py-2 text-xs text-zinc-500 font-mono">{img.caption}</p>
                )}
              </div>
            ))}
          </div>

          <!-- Lightbox -->
          <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/92 backdrop-blur p-4" role="dialog" aria-modal="true" aria-label="Image lightbox">
            <button id="lb-close" class="absolute top-4 right-4 p-2 text-zinc-400 hover:text-white rounded-full bg-zinc-800/80" aria-label="Close lightbox">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
            <img id="lb-img" src="" alt="" class="max-w-full max-h-[85vh] rounded-lg object-contain" />
            <p id="lb-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-sm text-zinc-400 font-mono bg-black/60 px-4 py-1.5 rounded-full"></p>
          </div>
        </>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  const items = document.querySelectorAll('[data-lightbox]');
  const lb    = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbCap = document.getElementById('lb-caption');
  const close = document.getElementById('lb-close');

  const open  = (src: string, cap: string) => {
    if (!lb || !lbImg || !lbCap) return;
    lbImg.src = src; lbCap.textContent = cap;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };
  const closeBox = () => {
    lb?.classList.add('hidden');
    lb?.classList.remove('flex');
    document.body.style.overflow = '';
  };

  items.forEach((el) => {
    const handler = () => open(el.getAttribute('data-lightbox') ?? '', el.getAttribute('data-caption') ?? '');
    el.addEventListener('click', handler);
    el.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') handler(); });
  });

  close?.addEventListener('click', closeBox);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeBox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeBox(); });
</script>
