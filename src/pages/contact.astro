---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Cybersecurity Portfolio" description="Get in touch for collaborations, speaking invitations, consulting, or just to say hello.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-2xl mx-auto">

      <div class="mb-12 animate-fade-up">
        <p class="section-label mb-3">Get in touch</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Contact</h1>
        <p class="text-zinc-400 leading-relaxed">
          Available for consulting, speaking engagements, security research collaborations,
          and advisory roles. Response time is usually within 24–48 hours.
        </p>
      </div>

      <!-- Contact cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12 animate-fade-up-1">
        {[
          { icon: 'linkedin', label: 'LinkedIn', value: '/in/jashwanth-raghav-5a9111313', href: 'https://linkedin.com/in/jashwanth-raghav-5a9111313/' },
          { icon: 'github', label: 'GitHub', value: '@z3rodayhacks', href: 'https://github.com/z3rodayhacks' },
        ].map(({ icon, label, value, href }) => (
          <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 bg-zinc-900/40 border border-zinc-800 rounded-lg hover:border-zinc-600 transition-all">
            <div class="w-10 h-10 rounded-lg bg-zinc-800 border border-zinc-700 flex items-center justify-center shrink-0 group-hover:bg-emerald-500/10 group-hover:border-emerald-500/30 transition-all">
              {icon === 'mail' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-zinc-400 group-hover:text-emerald-400 transition-colors" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              )}
              {icon === 'linkedin' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-zinc-400 group-hover:text-emerald-400 transition-colors" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              )}
              {icon === 'github' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-zinc-400 group-hover:text-emerald-400 transition-colors" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
              )}
              {icon === 'twitter' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-zinc-400 group-hover:text-emerald-400 transition-colors" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
            </div>
            <div>
              <p class="text-xs text-zinc-600 font-mono">{label}</p>
              <p class="text-sm text-zinc-200 group-hover:text-emerald-400 transition-colors">{value}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Availability note -->
      <div class="p-5 bg-emerald-500/5 border border-emerald-500/20 rounded-lg animate-fade-up-2">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-sm font-semibold text-emerald-400">Currently available</span>
        </div>
        <p class="text-sm text-zinc-400">
          Open to consulting engagements, part-time advisory roles, and interesting full-time
          positions in offensive security and security research.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
