---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { sortByDate, formatDate } from '../lib/utils';

const allComps = await getCollection('competitions');
const sorted   = sortByDate(allComps);

const RESULT_STYLE: Record<string, string> = {
  winner:      'bg-yellow-500/12 text-yellow-400 border-yellow-500/30',
  'runner-up': 'bg-zinc-400/12 text-zinc-300 border-zinc-400/30',
  finalist:    'bg-orange-500/12 text-orange-400 border-orange-500/30',
  participant: 'bg-zinc-700/30 text-zinc-500 border-zinc-700/40',
};

function resultStyle(result?: string) {
  if (!result) return '';
  const key = result.toLowerCase().replace(/\s+/g, '-');
  return RESULT_STYLE[key] ?? 'bg-emerald-500/12 text-emerald-400 border-emerald-500/30';
}

function youtubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([^&?/]+)/);
  return m ? m[1] : null;
}
---

<BaseLayout title="Competitions — Jashwanth Raghav" description="Hackathons, CTFs, and cybersecurity competitions participated in and won.">
  <div class="py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">

      <div class="mb-12">
        <p class="section-label mb-3">Competing</p>
        <h1 class="text-4xl font-bold text-zinc-100 mb-4">Competitions</h1>
        <p class="text-zinc-400 max-w-xl">
          Hackathons, CTF competitions, and cybersecurity challenges — building under pressure and learning along the way.
        </p>
      </div>

      {sorted.length === 0 ? (
        <div class="text-center py-20 border border-dashed border-zinc-800 rounded-lg">
          <p class="font-mono text-zinc-600">No competitions added yet.</p>
          <p class="text-zinc-700 text-sm mt-2">Add files to <code class="font-mono text-xs bg-zinc-900 px-1.5 py-0.5 rounded border border-zinc-800">src/content/competitions/</code></p>
        </div>
      ) : (
        <div class="flex flex-col gap-6" id="comp-list">
          {sorted.map((comp, compIdx) => {
            const vidId = comp.data.video ? youtubeId(comp.data.video as string) : null;
            return (
              <article class="bg-zinc-900/40 border border-zinc-800 rounded-lg overflow-hidden hover:border-zinc-700 transition-colors">
                <div class="p-6">
                  <!-- Meta row -->
                  <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-600 font-mono mb-3">
                    <time datetime={comp.data.date}>{formatDate(comp.data.date, { year: 'numeric', month: 'short' })}</time>
                    <span class="text-zinc-700">·</span>
                    <span class="text-emerald-400">{comp.data.event}</span>
                    {comp.data.organizer && <><span class="text-zinc-700">·</span><span>{comp.data.organizer}</span></>}
                    {comp.data.location  && <><span class="text-zinc-700">·</span>
                      <span class="flex items-center gap-1">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {comp.data.location}
                      </span>
                    </>}
                  </div>

                  <!-- Title + result badge -->
                  <div class="flex flex-wrap items-start gap-3 mb-2">
                    <h2 class="font-semibold text-zinc-100 text-lg leading-snug flex-1">{comp.data.title}</h2>
                    {comp.data.result && (
                      <span class={`shrink-0 px-2.5 py-0.5 rounded-full text-xs font-semibold border ${resultStyle(comp.data.result)}`}>
                        🏆 {comp.data.result}
                      </span>
                    )}
                  </div>

                  <p class="text-sm text-zinc-500 leading-relaxed mb-4">{comp.data.description}</p>

                  <!-- Team / project info -->
                  {(comp.data.team || comp.data.project || comp.data.teamSize) && (
                    <div class="flex flex-wrap gap-4 mb-4 text-xs text-zinc-500 font-mono">
                      {comp.data.team     && <span>👥 Team: <span class="text-zinc-300">{comp.data.team}</span></span>}
                      {comp.data.teamSize && <span>Size: <span class="text-zinc-300">{comp.data.teamSize}</span></span>}
                      {comp.data.project  && <span>🔧 Built: <span class="text-zinc-300">{comp.data.project}</span></span>}
                    </div>
                  )}

                  <!-- Tags -->
                  {comp.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-5">
                      {comp.data.tags.map((tag) => <span class="tag">{tag}</span>)}
                    </div>
                  )}

                  <!-- Action buttons -->
                  <div class="flex flex-wrap gap-3 mb-5">
                    {comp.data.linkedin && (
                      <a href={comp.data.linkedin} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-1.5 bg-blue-500/10 hover:bg-blue-500/15 border border-blue-500/25 text-blue-400 rounded text-sm transition-all">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        LinkedIn Post
                      </a>
                    )}
                    {comp.data.github && (
                      <a href={comp.data.github} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded text-sm transition-all">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        GitHub
                      </a>
                    )}
                    {comp.data.certificate && (
                      <a href={comp.data.certificate} target="_blank" rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-3 py-1.5 bg-yellow-500/10 hover:bg-yellow-500/15 border border-yellow-500/25 text-yellow-400 rounded text-sm transition-all">
                        🏅 Certificate
                      </a>
                    )}
                  </div>

                  <!-- Images gallery -->
                  {comp.data.images && comp.data.images.length > 0 && (
                    <div class={`grid gap-3 ${comp.data.images.length === 1 ? 'grid-cols-1' : 'grid-cols-2 sm:grid-cols-3'}`}>
                      {comp.data.images.map((img, imgIdx) => (
                        <button
                          type="button"
                          class="group relative rounded-lg overflow-hidden border border-zinc-800 bg-zinc-900 cursor-zoom-in"
                          data-gallery={`comp-${compIdx}`}
                          data-index={imgIdx}
                          data-images={JSON.stringify(comp.data.images)}
                          aria-label={`View image ${imgIdx + 1}`}
                        >
                          <img src={img} alt={`${comp.data.title} — image ${imgIdx + 1}`}
                            loading="lazy" decoding="async"
                            class="w-full h-40 object-cover group-hover:scale-105 group-hover:opacity-90 transition-all duration-500" />
                          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/30">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                          </div>
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 backdrop-blur-sm" role="dialog" aria-modal="true">
    <button id="lb-close" class="absolute top-4 right-4 z-10 p-2.5 rounded-full bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white transition-all" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button id="lb-prev" class="absolute left-3 sm:left-6 z-10 p-2.5 rounded-full bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white transition-all" aria-label="Previous">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="max-w-5xl max-h-[90vh] w-full px-16 flex items-center justify-center">
      <img id="lb-img" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-lg select-none" />
    </div>
    <button id="lb-next" class="absolute right-3 sm:right-6 z-10 p-2.5 rounded-full bg-zinc-800/80 hover:bg-zinc-700 text-zinc-300 hover:text-white transition-all" aria-label="Next">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
    </button>
    <div id="lb-counter" class="absolute bottom-5 left-1/2 -translate-x-1/2 text-xs font-mono text-zinc-500 bg-zinc-900/80 px-3 py-1 rounded-full"></div>
  </div>
</BaseLayout>

<script>
  let images: string[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter')!;

  function show(i: number) {
    current = (i + images.length) % images.length;
    lbImg.src = images[current];
    lbCounter.textContent = `${current + 1} / ${images.length}`;
    document.getElementById('lb-prev')!.style.display = images.length <= 1 ? 'none' : '';
    document.getElementById('lb-next')!.style.display = images.length <= 1 ? 'none' : '';
  }
  function open(imgs: string[], idx: number) {
    images = imgs; lb.classList.remove('hidden'); lb.classList.add('flex');
    document.body.style.overflow = 'hidden'; show(idx);
  }
  function close() { lb.classList.add('hidden'); lb.classList.remove('flex'); document.body.style.overflow = ''; }

  document.querySelectorAll('[data-gallery]').forEach(btn => {
    btn.addEventListener('click', () => open(JSON.parse(btn.getAttribute('data-images')!), parseInt(btn.getAttribute('data-index')!)));
  });
  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => show(current + 1));
  lb.addEventListener('click', e => { if (e.target === lb) close(); });
  document.addEventListener('keydown', e => {
    if (lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  let tx = 0;
  lb.addEventListener('touchstart', e => { tx = e.touches[0].clientX; });
  lb.addEventListener('touchend',   e => { const d = tx - e.changedTouches[0].clientX; if (Math.abs(d) > 50) show(d > 0 ? current + 1 : current - 1); });
</script>
