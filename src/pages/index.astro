---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import { getCollection } from 'astro:content';
import { sortByDate } from '../lib/utils';

const allProjects = await getCollection('projects');
const allPosts    = await getCollection('blog', ({ data }) => !data.draft);

const featuredProjects = sortByDate(allProjects.filter((p) => p.data.featured)).slice(0, 3);
const latestPosts      = sortByDate(allPosts).slice(0, 3);

const displayProjects = featuredProjects.length > 0
  ? featuredProjects
  : sortByDate(allProjects).slice(0, 3);
---

<BaseLayout
  title="Jashwanth Raghav R K — Cybersecurity Researcher & Security Consultant"
  description="Jashwanth Raghav R K is a Cybersecurity Researcher and Security Consultant specialising in malware analysis, penetration testing, and reverse engineering. OWASP SREC Chairman · CTF Player · IEEE Treasurer · Coimbatore, India."
  image="/profile/photo.jpg"
>
  <Hero />
  {displayProjects.length > 0 && <FeaturedProjects projects={displayProjects} />}
  {latestPosts.length > 0     && <LatestPosts posts={latestPosts} />}

  <!-- Now / Currently -->
  <section class="py-16 px-4 sm:px-6 border-t border-zinc-800/40">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-end justify-between mb-8">
        <div>
          <p class="section-label mb-2">Right now</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-zinc-100">Currently</h2>
        </div>
        <span class="hidden sm:flex items-center gap-1.5 text-xs font-mono text-zinc-600">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          live status
        </span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 bg-zinc-900/40 border border-zinc-800 rounded-lg">
          <p class="font-mono text-xs text-cyan-400 uppercase tracking-wider mb-2">Working on</p>
          <p class="text-zinc-100 font-medium mb-1">Security Research & Tooling</p>
          <p class="text-sm text-zinc-500">Building offensive security tools and conducting vulnerability research as Security Consultant at TechGuard Labs.</p>
        </div>
        <div class="p-5 bg-zinc-900/40 border border-zinc-800 rounded-lg">
          <p class="font-mono text-xs text-purple-400 uppercase tracking-wider mb-2">Learning</p>
          <p class="text-zinc-100 font-medium mb-1">Advanced Malware Analysis</p>
          <p class="text-sm text-zinc-500">Deep-diving into malware internals, unpacking techniques, and anti-analysis evasion methods.</p>
        </div>
        <div class="p-5 bg-zinc-900/40 border border-zinc-800 rounded-lg">
          <p class="font-mono text-xs text-zinc-400 uppercase tracking-wider mb-2">Open to</p>
          <p class="text-zinc-100 font-medium mb-1">Collaborations & Consulting</p>
          <p class="text-sm text-zinc-500">Available for security consulting, CTF teaming, speaking engagements, and advisory roles.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Certificates + Competitions teaser -->
  <section class="py-16 px-4 sm:px-6 border-t border-zinc-800/40">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="p-6 bg-zinc-900/40 border border-zinc-800 rounded-lg text-center hover:border-zinc-700 transition-colors">
          <p class="section-label mb-2">Credentials</p>
          <h2 class="text-lg font-bold text-zinc-100 mb-2">Certifications</h2>
          <p class="text-zinc-500 text-sm mb-5">Industry-recognised security certifications and course completions.</p>
          <a href="/certificates" class="inline-flex items-center gap-2 px-4 py-2 border border-zinc-700 hover:border-cyan-500/40 text-zinc-300 hover:text-cyan-400 rounded text-sm font-medium transition-all">
            View Certificates →
          </a>
        </div>
        <div class="p-6 bg-zinc-900/40 border border-zinc-800 rounded-lg text-center hover:border-zinc-700 transition-colors">
          <p class="section-label mb-2">Competing</p>
          <h2 class="text-lg font-bold text-zinc-100 mb-2">Competitions</h2>
          <p class="text-zinc-500 text-sm mb-5">Hackathons, CTFs, and cybersecurity challenges.</p>
          <a href="/competitions" class="inline-flex items-center gap-2 px-4 py-2 border border-zinc-700 hover:border-cyan-500/40 text-zinc-300 hover:text-cyan-400 rounded text-sm font-medium transition-all">
            View Competitions →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
